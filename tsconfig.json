{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "harness.ts",
    "lib/**/*.ts",
    "evals/**/*.ts",
    "examples/**/*.ts",
    "test/**/*.ts"
  ]
}
